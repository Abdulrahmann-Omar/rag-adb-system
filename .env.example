# ===========================================
# Environment Configuration Template
# RAG System for Advanced Database Course
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ===========================================

# -----------------
# REQUIRED: GitHub Models API
# -----------------
# Get your token at: https://github.com/settings/tokens
# Required scopes: Models API access
GITHUB_TOKEN=your_github_personal_access_token_here

# -----------------
# LLM Configuration
# -----------------
# Model to use for answer generation
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
MODEL_NAME=gpt-4o-mini

# Temperature for response generation (0.0 - 1.0)
# Lower = more focused, Higher = more creative
LLM_TEMPERATURE=0.7

# Maximum tokens in generated response
LLM_MAX_TOKENS=1000

# -----------------
# Embedding Configuration
# -----------------
# HuggingFace model for text embeddings
# Recommended: all-MiniLM-L6-v2 (fast, good quality)
# Alternative: all-mpnet-base-v2 (better quality, slower)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------
# Document Processing
# -----------------
# Maximum characters per text chunk
CHUNK_SIZE=1000

# Overlap between consecutive chunks (for context)
CHUNK_OVERLAP=200

# -----------------
# Retrieval Configuration
# -----------------
# Number of documents to retrieve per query
TOP_K=5

# Weight for semantic search (0.0 - 1.0)
# Keyword weight = 1.0 - SEMANTIC_WEIGHT
SEMANTIC_WEIGHT=0.7

# -----------------
# Paths
# -----------------
# Path to lecture PDFs (relative or absolute)
LECTURES_PATH=./Lectures

# Path to vector store (index persistence)
VECTOR_STORE_PATH=./data/vector_store

# -----------------
# Application Settings
# -----------------
# Enable debug mode (verbose logging)
DEBUG=False

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
